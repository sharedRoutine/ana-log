{
  "expo": {
    "name": "Ana|Log",
    "slug": "ana-log",
    "version": "1.0.0",
    "scheme": "ana-log",
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-web-browser",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ana|Log verwendet Face ID, um dein Logbuch zu schützen."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.jnsh.analog",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUbiquitousContainers": {
          "iCloud.me.jnsh.analog": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Ana|Log",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.me.jnsh.analog"
        ],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.me.jnsh.analog"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "me.jnsh.analog"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5e1af85-559b-43c1-891e-3713bef16b68"
      }
    }
  }
}
